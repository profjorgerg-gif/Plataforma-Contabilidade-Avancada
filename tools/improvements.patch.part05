+  #cont-avancada .status-badge.info { color:#8BD7EA; background:rgba(46,140,168,.15); border-color:rgba(46,140,168,.5); }
+  #cont-avancada .status-badge.warn { color:#F2C678; background:rgba(210,155,70,.14); border-color:rgba(210,155,70,.5); }
+  #cont-avancada .status-badge.neutral { color:var(--ink-soft); background:#182536; }
+  #cont-avancada .module-correction { margin-top:24px; padding:16px; border:1px solid #31566A; border-left:4px solid var(--brass); background:rgba(46,140,168,.08); }
+  #cont-avancada .feedback-box { padding:10px 12px; margin:8px 0; border-left:3px solid #D49A46; background:rgba(212,154,70,.10); color:var(--ink); font-size:13px; }
+  #cont-avancada .review-card { background:var(--card); border:1px solid var(--line); border-left:4px solid var(--brass); padding:16px; margin-bottom:14px; }
+  #cont-avancada .review-head { display:flex; justify-content:space-between; gap:12px; align-items:flex-start; margin-bottom:12px; }
+  #cont-avancada .review-grid { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:8px; margin:12px 0; }
+  #cont-avancada .review-grid > div { background:#182536; border:1px solid var(--line); padding:8px 10px; }
+  #cont-avancada .review-grid span { display:block; font-size:10.5px; color:var(--ink-soft); }
+  #cont-avancada .review-grid b { font-size:16px; }
+  #cont-avancada .grade-input, #cont-avancada .review-feedback { width:100%; background:#0F1724; color:var(--ink); border:1px solid #3A4C60; padding:9px 10px; font-family:inherit; }
+  #cont-avancada .review-feedback { min-height:74px; resize:vertical; }
+  #cont-avancada .review-actions, #cont-avancada .toolbar, #cont-avancada .support-meta { display:flex; justify-content:flex-end; gap:8px; align-items:center; flex-wrap:wrap; margin:12px 0; }
+  #cont-avancada .support-meta { justify-content:space-between; }
+  #cont-avancada .support-meta > div { display:flex; gap:8px; align-items:center; flex-wrap:wrap; }
+  #cont-avancada .table-scroll { overflow-x:auto; }
+  #cont-avancada .cell-status { font-size:9.5px; color:var(--ink-soft); white-space:nowrap; margin-top:2px; }
+  #cont-avancada input[type=number] { border-radius:2px; }
+  @media (max-width:800px) {
+    #cont-avancada .review-grid { grid-template-columns:repeat(2,minmax(0,1fr)); }
+    #cont-avancada .review-actions .btn-outline, #cont-avancada .review-actions .btn-brass { flex:1; }
+    #cont-avancada table.roster { min-width:760px; }
+  }
+  @media print {
+    body { background:#fff !important; }
+    #cont-avancada { --paper:#fff; --card:#fff; --ink:#111; --ink-soft:#555; --line:#bbb; background:#fff !important; background-image:none !important; color:#111 !important; }
+    #cont-avancada .masthead, #cont-avancada .topnav, #cont-avancada .toolbar, #cont-avancada #btn-logout { display:none !important; }
+    #cont-avancada .wrap { max-width:none; padding:0; }
+    #cont-avancada table.roster { color:#111; background:#fff; }
+    #cont-avancada .cell-status { color:#555; }
+  }
+
