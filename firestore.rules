rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isActiveUser() {
      return isSignedIn() && myRole() in ['aluno', 'professor', 'admin'];
    }
    function isProfessorOrAdmin() {
      return isSignedIn() && myRole() in ['professor', 'admin'];
    }

    // Perfil de cada usuário. Professores novos entram como pending_professor
    // e somente um Usuário Mestre pode promovê-los a professor.
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || myRole() == 'admin');
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow update: if isSignedIn() && (
        (request.auth.uid == uid && request.resource.data.role == resource.data.role) ||
        myRole() == 'admin'
      );
      allow delete: if false;
    }

    // Armazenamento pedagógico da plataforma. Contas pending_professor ficam
    // sem acesso até a aprovação do Usuário Mestre.
    match /kv_store/{key} {
      allow read, write: if isActiveUser();
    }
  }
}
